// Design tokens shared by every screen.

export global Theme {
    // Surfaces
    out property <color> bg: #f5f7fb;
    out property <color> surface: #ffffff;
    out property <color> surface-alt: #f8fafc;
    out property <color> border: #e2e8f0;
    out property <color> border-strong: #cbd5e1;

    // Text
    out property <color> text: #0f172a;
    out property <color> text-muted: #64748b;
    out property <color> text-subtle: #94a3b8;
    out property <color> on-primary: #ffffff;

    // Brand
    out property <color> primary: #4f46e5;
    out property <color> primary-hover: #4338ca;
    out property <color> primary-pressed: #3730a3;
    out property <color> primary-soft: #eef2ff;
    out property <color> primary-soft-2: #e0e7ff;

    // Sidebar
    out property <color> nav-bg: #111827;
    out property <color> nav-text: #cbd5e1;
    out property <color> nav-active: #1f2937;

    // Status
    out property <color> success: #047857;
    out property <color> success-soft: #ecfdf5;
    out property <color> warning: #b45309;
    out property <color> warning-soft: #fffbeb;
    out property <color> danger: #dc2626;
    out property <color> danger-hover: #b91c1c;
    out property <color> danger-soft: #fef2f2;
    out property <color> neutral-soft: #f1f5f9;

    // Shape & type
    out property <length> radius-sm: 6px;
    out property <length> radius: 10px;
    out property <length> radius-lg: 16px;
    out property <length> font-xs: 11px;
    out property <length> font-sm: 12px;
    out property <length> font-md: 14px;
    out property <length> font-lg: 16px;
    out property <length> font-xl: 20px;
    out property <length> font-2xl: 26px;

    // Responsive breakpoint (set by the main window)
    in-out property <bool> compact: false;

    public pure function status-fg(status: string) -> color {
        if status == "paid" { return root.success; }
        if status == "confirmed" { return root.warning; }
        if status == "cancelled" { return root.danger; }
        if status == "overdue" { return root.danger; }
        return root.text-muted;
    }

    public pure function status-bg(status: string) -> color {
        if status == "paid" { return root.success-soft; }
        if status == "confirmed" { return root.warning-soft; }
        if status == "cancelled" { return root.danger-soft; }
        if status == "overdue" { return root.danger-soft; }
        return root.neutral-soft;
    }
}

